# Copy to .env.local and fill in. Never commit .env.local.
# StudioNet — GenLayer hosted dev network (NOT mainnet, no real funds)
NEXT_PUBLIC_GENLAYER_RPC=https://studio.genlayer.com/api
NEXT_PUBLIC_CHAIN_ID=61999
NEXT_PUBLIC_EXPLORER_URL=https://explorer-studio.genlayer.com
NEXT_PUBLIC_CONTRACT_ADDRESS=
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
# false = live StudioNet reads when a wallet is connected (mock seeds otherwise).
# true  = always serve mock seeds (offline demo).
NEXT_PUBLIC_MOCK_MODE=false
